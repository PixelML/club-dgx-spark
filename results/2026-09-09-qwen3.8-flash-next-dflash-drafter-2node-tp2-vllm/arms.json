 "headline": {
  "claim": "DFlash block 5 beats the tuned native MTP baseline (k=4) by +3.87% in aggregate output throughput, 95% CI [+2.10%, +5.77%].",
  "second_best": "DFlash block 4, +3.26% [+1.84%, +4.79%].",
  "both_exclude_zero": true,
  "against_the_softer_k3_baseline": "block 5 +4.50% [+2.35%, +6.80%]; the 2026-09-08 single-boot set read +4.59% [+2.14%, +7.06%] against the same baseline.",
  "workload_shape": "a math win (+28.0% at block 5), a code wash (+0.37%, CI spans zero), and a chat regression at every servable block.",
  "caveat": "boot-to-boot variance is not in the interval; see boot_variance_disclosure."
 },
 "chat_regression_by_block_vs_mtp_k4": {
  "note": "Chat regresses at EVERY block that can be served and every interval excludes zero. It does not improve monotonically as the block shrinks: it bottoms out at blocks 3 and 4 near -3.9% and gets worse again at block 2, which also gives up most of the math gain (-7.28%). The \"untested where it could pass\" possibility is closed: the narrow math-and-code-only release fails on measurement, not on assumption.",
  "blocks": {
   "2": {
    "chat_pct": -6.133,
    "ci95": [
     -8.098,
     -4.13
    ]
   },
   "3": {
    "chat_pct": -3.866,
    "ci95": [
     -5.742,
     -2.043
    ]
